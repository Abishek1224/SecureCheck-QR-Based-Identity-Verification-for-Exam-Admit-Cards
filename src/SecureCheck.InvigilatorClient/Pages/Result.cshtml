@page
@model SecureCheck.InvigilatorClient.Pages.ResultModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Verification Result";
}

<link rel="stylesheet" href="~/css/site.css" />

<h1>Candidate Verification</h1>

<div id="result-card">
    <p>Waiting for verification...</p>
</div>

<div id="api-config"
     data-base-url="@Configuration["SecureCheckApi:BaseUrl"]"
     data-api-key="@Configuration["SecureCheckApi:ApiKey"]"></div>

<a href="/Scan">Scan Another Candidate</a>

<script src="~/js/result.js"></script>